APP_NAME=LaporOB
COMPANY_NAME=PT WGS
LOGO_URL=/uploads/wgs-logo.png

DATABASE_URL="postgresql://devuser:devpassword@postgres_db:5432/lapor_ob?schema=public"
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=lapor_ob
JWT_TOKEN=[token]
APP_PORT=8000
TZ=Asia/Jakarta

BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

STORAGE_PROVIDER=local

# Kalo STORAGE_PROVIDER=cloud, isi ini:
CLOUD_UPLOAD_URL=[key]
CLOUD_UPLOAD_API_KEY=[key]

REDIS_PASSWORD=[password]
REDIS_URL=redis://default:[password]@redis:6379

EMAIL_DRIVER=gmail
EMAIL_PORT=587

SMTP_HOST=smtp.gmail.com
SMTP_USER=[user]
SMTP_PASS=[pass]

MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_API_KEY=[key]
MAILTRAP_SENDER=[sender]
MAILTRAP_INBOX_ID=[inbox_id]


