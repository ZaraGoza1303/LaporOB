# Template SEMUA environment (dev/staging/prod). Satu-satunya file env yang di-commit.
# Cara pakai: salin jadi `.env` lalu isi nilai asli. Nilai asli JANGAN pernah di-commit —
# set lewat environment variables di platform deploy / secret manager.
# Komentar "wajib"/"opsional"/"khusus env" menandai kebutuhan tiap key.

# --- Wajib semua env ---
APP_NAME=LaporOB
COMPANY_NAME=PT WGS
LOGO_URL=/uploads/wgs-logo.png

# Contoh dev lokal (docker-compose.yml). Staging/prod ganti host, user, password, nama DB.
DATABASE_URL="postgresql://user:pass@host:5432/app?schema=public"
JWT_TOKEN=[isi-token-rahasia-yang-beda-tiap-env]
APP_PORT=8000
TZ=Asia/Jakarta

# Base URL sesuai deployment masing-masing (dev: localhost, staging/prod: domain asli)
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# Non-rahasia, default boleh beda per env (dev: local, prod: cloud)
STORAGE_PROVIDER=local

# --- Wajib jika STORAGE_PROVIDER=cloud (biasanya staging/prod) ---
CLOUD_UPLOAD_URL=
CLOUD_UPLOAD_API_KEY=

# --- Wajib semua env (kredensial redis tiap env harus beda) ---
REDIS_PASSWORD=[password]
REDIS_URL=redis://default:[password]@redis:6379

# --- Email: pilih salah satu driver per env ---
# Dev boleh gmail, staging pakai mailtrap agar tidak kirim email asli, prod pakai smtp resmi.
EMAIL_DRIVER=gmail
EMAIL_PORT=587

# Wajib jika EMAIL_DRIVER=gmail/smtp
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=

# Wajib jika EMAIL_DRIVER=mailtrap (staging)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_API_KEY=
MAILTRAP_SENDER=
MAILTRAP_INBOX_ID=
