# PROD — salin jadi .env.prod di server produksi, JANGAN commit file aslinya.
# Hanya diisi dari server env / secret manager. JANGAN seed, JANGAN pakai kredensial dev/staging.

APP_NAME=LaporOB
COMPANY_NAME=PT WGS
LOGO_URL=/uploads/wgs-logo.png

DATABASE_URL="postgresql://produser:[password]@postgres_db:5432/lapor_ob?schema=public"
JWT_TOKEN=[isi-token-prod-yang-beda-dari-dev-dan-staging]
APP_PORT=8000
TZ=Asia/Jakarta

BACKEND_BASE_URL=https://api.contoh.net
FRONTEND_BASE_URL=https://app.contoh.net

STORAGE_PROVIDER=cloud

# Kalo STORAGE_PROVIDER=cloud, isi ini:
CLOUD_UPLOAD_URL=
CLOUD_UPLOAD_API_KEY=

REDIS_PASSWORD=[password-prod]
REDIS_URL=redis://default:[password-prod]@redis:6379

EMAIL_DRIVER=smtp
EMAIL_PORT=587

SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=

MAILTRAP_HOST=
MAILTRAP_API_KEY=
MAILTRAP_SENDER=
MAILTRAP_INBOX_ID=
