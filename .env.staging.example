# STAGING — salin jadi .env.staging di server staging, JANGAN commit file aslinya.
# DB staging = salinan sanitized dari prod. JANGAN pernah seed dummy di sini
# (image staging/prod tidak menjalankan `prisma db seed`).

APP_NAME=LaporOB
COMPANY_NAME=PT WGS
LOGO_URL=/uploads/wgs-logo.png

DATABASE_URL="postgresql://staginguser:[password]@postgres_db:5432/lapor_ob_staging?schema=public"
JWT_TOKEN=[isi-token-staging-yang-beda-dari-dev-dan-prod]
APP_PORT=8000
TZ=Asia/Jakarta

BACKEND_BASE_URL=https://api-staging.contoh.net
FRONTEND_BASE_URL=https://app-staging.contoh.net

STORAGE_PROVIDER=local

# Kalo STORAGE_PROVIDER=cloud, isi ini:
CLOUD_UPLOAD_URL=
CLOUD_UPLOAD_API_KEY=

REDIS_PASSWORD=[password-staging]
REDIS_URL=redis://default:[password-staging]@redis:6379

# Staging pakai mailtrap agar tidak kirim email asli ke user
EMAIL_DRIVER=mailtrap
EMAIL_PORT=587

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_USER=
SMTP_PASS=

MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_API_KEY=
MAILTRAP_SENDER=
MAILTRAP_INBOX_ID=
