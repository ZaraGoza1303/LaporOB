// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(50)
  email        String   @unique @db.VarChar(100)
  password     String   @db.VarChar(255)
  nama_lengkap String   @db.VarChar(100)
  profile_picture String? @db.VarChar(255) 
  role_id      String   @db.Uuid
  is_deleted   Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @updatedAt @db.Timestamp(6)

  role                    Role               @relation(fields: [role_id], references: [id])
  checklist_harian        Checklist_harian[]
  laporan_sebagai_pelapor Laporan_karyawan[] @relation("LaporanPelapor")
  laporan_sebagai_ob      Laporan_karyawan[] @relation("LaporanOb")
  histori_pekerjaan                 Histori_pekerjaan[]
  tugas_dibuat            Tugas[]            @relation("TugasCreatedBy")
  tokens UserToken[]

  @@map("user")
}

model UserToken {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar(255)
  type       String    @db.VarChar(30) 
  expired_at DateTime  @db.Timestamp(6)
  created_at DateTime  @default(now()) @db.Timestamp(6)

  user User @relation(fields: [user_id], references: [id])

  @@map("user_token")
}

model Role {
  id         String   @id @default(uuid()) @db.Uuid
  nama_role  String   @unique @db.VarChar(50)
  created_at DateTime @default(now()) @db.Timestamp(6)

  users User[]

  @@map("role")
}

model Lokasi {
  id          String   @id @default(uuid()) @db.Uuid
  nama_lokasi String   @db.VarChar(100)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @updatedAt @db.Timestamp(6)

  lantai Lantai[]

  @@map("lokasi")
}

model Lantai {
  id           String   @id @default(uuid()) @db.Uuid
  lokasi_id    String   @db.Uuid
  nomor_lantai Int
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @updatedAt @db.Timestamp(6)

  lokasi Lokasi @relation(fields: [lokasi_id], references: [id])

  checklist_harian Checklist_harian[]
  laporan_karyawan Laporan_karyawan[]

  @@map("lantai")
}

model Kategori {
  id            String   @id @default(uuid()) @db.Uuid
  nama_kategori String   @db.VarChar(100)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @updatedAt @db.Timestamp(6)

  tugas            Tugas[]
  laporan_karyawan Laporan_karyawan[]
  checklist_harian Checklist_harian[]

  @@map("kategori")
}

model Tugas {
  id            String   @id @default(uuid()) @db.Uuid
  kategori_id   String   @db.Uuid
  nama_tugas    String   @db.VarChar(150)
  is_active     Boolean  @default(true)
  created_by_id String?  @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @updatedAt @db.Timestamp(6)

  kategori   Kategori @relation(fields: [kategori_id], references: [id])
  created_by User?    @relation("TugasCreatedBy", fields: [created_by_id], references: [id])

  checklist_harian Checklist_harian[]

  @@map("tugas")
}

model Checklist_harian {
  id          String   @id @default(uuid()) @db.Uuid
  tanggal     DateTime @db.Date
  ob_id       String   @db.Uuid
  lantai_id   String   @db.Uuid
  kategori_id String   @db.Uuid
  tugas_id    String   @db.Uuid
  status      String   @db.VarChar(30)
  notes       String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @updatedAt @db.Timestamp(6)

  ob       User     @relation(fields: [ob_id], references: [id])
  lantai   Lantai   @relation(fields: [lantai_id], references: [id])
  kategori Kategori @relation(fields: [kategori_id], references: [id])
  tugas    Tugas    @relation(fields: [tugas_id], references: [id])

  @@map("checklist_harian")
}

model Laporan_karyawan {
  id                String   @id @default(uuid()) @db.Uuid
  pelapor_id        String   @db.Uuid
  ob_id             String?  @db.Uuid
  lantai_id         String   @db.Uuid
  kategori_id       String   @db.Uuid
  deskripsi_kendala String   @db.Text
  status            String   @db.VarChar(30)
  foto_masalah      String   @db.VarChar(255)
  created_at        DateTime @default(now()) @db.Timestamp(6)
  updated_at        DateTime @updatedAt @db.Timestamp(6)

  pelapor  User     @relation("LaporanPelapor", fields: [pelapor_id], references: [id])
  ob       User?    @relation("LaporanOb", fields: [ob_id], references: [id])
  lantai   Lantai   @relation(fields: [lantai_id], references: [id])
  kategori Kategori @relation(fields: [kategori_id], references: [id])

  histori_pekerjaan Histori_pekerjaan[]

  @@map("laporan_karyawan")
}

model Histori_pekerjaan {
  id                  String   @id @default(uuid()) @db.Uuid
  laporan_karyawan_id String   @db.Uuid
  ob_id               String   @db.Uuid
  status_aksi         String   @db.VarChar(30)
  foto_selesai        String?  @db.VarChar(255)
  created_at          DateTime @default(now()) @db.Timestamp(6)

  laporan Laporan_karyawan @relation(fields: [laporan_karyawan_id], references: [id])
  ob      User             @relation(fields: [ob_id], references: [id])

  @@map("histori_pekerjaan")
}