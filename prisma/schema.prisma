// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(50)
  email        String   @unique @db.VarChar(100)
  password     String?  @db.VarChar(255)
  nama_lengkap String   @db.VarChar(100)
  profile_picture String? @db.VarChar(255) 
  role_id      String   @db.Uuid
  is_active    Boolean  @default(false)
  is_deleted   Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @updatedAt @db.Timestamp(6)

  role                    Role               @relation(fields: [role_id], references: [id])
  checklist_harian        Checklist_harian[]
  jadwal_checklist        JadwalChecklist[]
  laporan_sebagai_pelapor Laporan_karyawan[] @relation("LaporanPelapor")
  laporan_sebagai_ob      Laporan_karyawan[] @relation("LaporanOb")
  tokens                  UserToken[]
  notifikasi_diterima     Notifikasi[]       @relation("NotifikasiDiterima")
  notifikasi_dikirim      Notifikasi[]       @relation("NotifikasiDikirim")
  penugasan_ob            PenugasanOb[]
  kolaborasi_laporan      KolaborasiLaporan[]
  histori_pekerjaan       Histori_pekerjaan[]
  sessions                UserSession[]
  tugas_ob                Tugas[]        @relation("TugasOb")
  skills                  ObSkill[]
  ob_achievements         ObAchievement[]

  @@map("user")
}

model UserToken {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar(255)
  type       String    @db.VarChar(30) 
  expired_at DateTime  @db.Timestamp(6)
  used_at    DateTime? @db.Timestamp(6)   
  created_at DateTime  @default(now()) @db.Timestamp(6)

user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_token")
}

model Role {
  id         String   @id @default(uuid()) @db.Uuid
  nama_role  String   @unique @db.VarChar(50)
  created_at DateTime @default(now()) @db.Timestamp(6)

  users User[]

  @@map("role")
}

model Lokasi {
  id          String   @id @default(uuid()) @db.Uuid
  nama_lokasi String   @db.VarChar(100)
  alamat      String?  @db.VarChar(255)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @updatedAt @db.Timestamp(6)

  lantai Lantai[]
  penugasan_ob PenugasanOb[]

  @@map("lokasi")
}

model PenugasanOb {
  id         String   @id @default(uuid()) @db.Uuid
  ob_id      String   @db.Uuid
  lokasi_id  String   @db.Uuid
  bulan      Int     
  tahun      Int    
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)

  ob     User   @relation(fields: [ob_id], references: [id], onDelete: Cascade)
  lokasi Lokasi @relation(fields: [lokasi_id], references: [id], onDelete: Cascade)

  @@unique([ob_id, lokasi_id, bulan, tahun])
  @@map("penugasan_ob")
}

model Lantai {
  id           String   @id @default(uuid()) @db.Uuid
  lokasi_id    String   @db.Uuid
  nomor_lantai Int
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @updatedAt @db.Timestamp(6)

  lokasi Lokasi @relation(fields: [lokasi_id], references: [id], onDelete: Cascade)

  checklist_harian Checklist_harian[]
  jadwal_checklist JadwalChecklist[]
  laporan_karyawan Laporan_karyawan[]
  ruangan          Ruangan[]
  tugas            Tugas[]

  @@map("lantai")
}

model Ruangan {
  id         String   @id @default(uuid()) @db.Uuid
  lantai_id  String   @db.Uuid
  nama       String  
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)

  lantai           Lantai             @relation(fields: [lantai_id], references: [id], onDelete: Cascade)
  laporan_karyawan Laporan_karyawan[]

  @@map("ruangan")
}

model Kategori {
  id            String   @id @default(uuid()) @db.Uuid
  nama_kategori String   @db.VarChar(100)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @updatedAt @db.Timestamp(6)

  tugas            Tugas[]
  laporan_karyawan Laporan_karyawan[]
  checklist_harian Checklist_harian[]
  jadwal_checklist JadwalChecklist[]

  @@map("kategori")
}

model Tugas {
  id             String    @id @default(uuid()) @db.Uuid
  kategori_id    String    @db.Uuid
  nama_tugas     String    @db.VarChar(150)
  lantai_id      String?   @db.Uuid
  ob_id          String?   @db.Uuid
  status         String    @default("BELUM_DIKERJAKAN") @db.VarChar(30)
  catatan        String?   @db.Text
  foto_awal      String[]   @db.VarChar(255)
  foto_akhir     String[]   @db.VarChar(255)
  dikerjakan_at  DateTime? @db.Timestamp(6)
  selesai_at     DateTime? @db.Timestamp(6)
  is_active      Boolean   @default(true)
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  updated_at     DateTime  @updatedAt @db.Timestamp(6)

  hari            String[]   @default([])
  tanggal_ulang   Int?
  tanggal_spesifik DateTime[] @default([])
  tanggal_mulai   DateTime?  @db.Timestamp(6)
  tanggal_selesai DateTime   @db.Timestamp(6)

  is_approved    Boolean   @default(false)
  approved_at    DateTime? @db.Timestamp(6)

  kategori  Kategori @relation(fields: [kategori_id], references: [id], onDelete: Cascade)
  lantai    Lantai?  @relation(fields: [lantai_id], references: [id])
  ob        User?    @relation("TugasOb", fields: [ob_id], references: [id])

  @@map("tugas")
}

model Checklist_harian {
  id              String    @id @default(uuid()) @db.Uuid
  tanggal         DateTime  @db.Date
  nama_tugas      String    @db.VarChar(150)
  ob_id           String?   @db.Uuid
  lantai_id       String    @db.Uuid
  kategori_id     String    @db.Uuid
  status          String    @db.VarChar(30)
  catatan         String?   @db.Text
  dikerjakan_at   DateTime? @db.Timestamp(6)
  selesai_at      DateTime? @db.Timestamp(6)
  terlewat_at     DateTime? @db.Timestamp(6)

  is_approved    Boolean   @default(false)
  approved_at    DateTime? @db.Timestamp(6)

  created_at      DateTime  @default(now()) @db.Timestamp(6)
  updated_at      DateTime  @updatedAt @db.Timestamp(6)

  ob       User?    @relation(fields: [ob_id], references: [id])
  lantai   Lantai   @relation(fields: [lantai_id], references: [id])
  kategori Kategori @relation(fields: [kategori_id], references: [id])

  @@unique([tanggal, nama_tugas, lantai_id, ob_id])
  @@map("checklist_harian")
}

model JadwalChecklist {
  id          String    @id @default(uuid()) @db.Uuid
  nama_tugas  String    @db.VarChar(150)
  lantai_id   String    @db.Uuid
  kategori_id String    @db.Uuid
  ob_id       String?   @db.Uuid

  hari String[] @default([])

  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime  @updatedAt @db.Timestamp(6)

  ob       User?    @relation(fields: [ob_id], references: [id])
  lantai   Lantai   @relation(fields: [lantai_id], references: [id])
  kategori Kategori @relation(fields: [kategori_id], references: [id])

  @@map("jadwal_checklist")
}

model SkillDefinition {
  id         String   @id @default(uuid()) @db.Uuid
  nama_skill String   @db.VarChar(100)
  keyword    String[] @default([])
  deskripsi  String?  @db.Text
  is_auto    Boolean  @default(true)
  is_active  Boolean  @default(true)
  threshold  Int      @default(5)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)

  ob_skills ObSkill[]

  @@map("skill_definition")
}

model ObSkill {
  id             String    @id @default(uuid()) @db.Uuid
  ob_id          String    @db.Uuid
  skill_id       String    @db.Uuid
  jumlah_selesai Int       @default(0)
  assigned_by    String?   @db.Uuid
  diperoleh_at   DateTime?
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  updated_at     DateTime  @updatedAt @db.Timestamp(6)

  ob    User           @relation(fields: [ob_id], references: [id], onDelete: Cascade)
  skill SkillDefinition @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@unique([ob_id, skill_id])
  @@map("ob_skill")
}

model Achievement {
  id                              String   @id @default(uuid()) @db.Uuid
  nama                            String   @db.VarChar(100)
  deskripsi                       String?  @db.Text
  tipe                            String   @default("KEYWORD") @db.VarChar(30)
  keyword                         String[] @default([])
  threshold                       Int      @default(5)
  response_time_threshold_seconds Int?
  icon                            String?  @db.VarChar(255)
  is_active                       Boolean  @default(true)
  created_at                      DateTime @default(now()) @db.Timestamp(6)
  updated_at                      DateTime @updatedAt @db.Timestamp(6)

  ob_achievements ObAchievement[]

  @@map("achievement")
}

model ObAchievement {
  id             String    @id @default(uuid()) @db.Uuid
  ob_id          String    @db.Uuid
  achievement_id String    @db.Uuid
  progress       Int       @default(0)
  diperoleh_at   DateTime?
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  updated_at     DateTime  @updatedAt @db.Timestamp(6)

  ob          User        @relation(fields: [ob_id], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievement_id], references: [id], onDelete: Cascade)

  @@unique([ob_id, achievement_id])
  @@map("ob_achievement")
}

model Laporan_karyawan {
  id                String   @id @default(uuid()) @db.Uuid
  pelapor_id        String   @db.Uuid
  ob_id             String?  @db.Uuid
  lantai_id         String   @db.Uuid
  ruangan_id        String   @db.Uuid
  kategori_id       String   @db.Uuid
  deskripsi_kendala String   @db.Text
  status            String   @db.VarChar(30)
  prioritas         String   @default("STANDARD") @db.VarChar(20)
  foto_masalah      String[]   @db.VarChar(255)
  alasan_gagal      String?   @db.Text
  admin_catatan     String?   @db.Text
  is_approved       Boolean   @default(false)
  is_kolaborasi_open Boolean   @default(false)
  catatan_kolaborasi String?   @db.Text
  dikerjakan_at     DateTime? @db.Timestamp(6)
  selesai_at        DateTime? @db.Timestamp(6)
  dibatalkan_at     DateTime? @db.Timestamp(6)
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime  @updatedAt @db.Timestamp(6)


  pelapor  User     @relation("LaporanPelapor", fields: [pelapor_id], references: [id])
  ob       User?    @relation("LaporanOb", fields: [ob_id], references: [id])
  lantai   Lantai   @relation(fields: [lantai_id], references: [id])
  ruangan  Ruangan  @relation(fields: [ruangan_id], references: [id])
  kategori Kategori @relation(fields: [kategori_id], references: [id])

  kolaborasi       KolaborasiLaporan[]
  histori_pekerjaan Histori_pekerjaan[]

  @@map("laporan_karyawan")
}

model KolaborasiLaporan {
  id         String   @id @default(uuid()) @db.Uuid
  laporan_id String   @db.Uuid
  ob_id      String   @db.Uuid
  status     String   @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)

  laporan Laporan_karyawan @relation(fields: [laporan_id], references: [id], onDelete: Cascade)
  ob      User             @relation(fields: [ob_id], references: [id])

  @@unique([laporan_id, ob_id])
  @@map("kolaborasi_laporan")
}

model Histori_pekerjaan {
  id                  String   @id @default(uuid()) @db.Uuid
  laporan_karyawan_id String   @db.Uuid
  ob_id               String?  @db.Uuid
  foto_selesai        String[]  @db.VarChar(255)
  catatan             String   @db.Text
  created_at          DateTime @default(now()) @db.Timestamp(6)

  laporan Laporan_karyawan @relation(fields: [laporan_karyawan_id], references: [id], onDelete: Cascade)
  ob      User?            @relation(fields: [ob_id], references: [id])

  @@map("histori_pekerjaan")
}

model UserSession {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  token_hash   String    @unique @db.VarChar(255)
  device_info  String?   @db.VarChar(255)
  ip_address   String?   @db.VarChar(45)
  last_activity DateTime? @db.Timestamp(6)
  expired_at   DateTime  @db.Timestamp(6)
  is_revoked   Boolean   @default(false)
  revoked_at   DateTime? @db.Timestamp(6)
  created_at   DateTime  @default(now()) @db.Timestamp(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_session")
}

model AppSetting {
  id         String   @id @default(uuid()) @db.Uuid
  key        String   @unique @db.VarChar(50)
  value      String?  @db.Text
  type       String   @default("text") @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)

  @@map("app_setting")
}

model Notifikasi {
  id          String    @id @default(uuid()) @db.Uuid
  penerima_id     String    @db.Uuid
  pengirim_id String    @db.Uuid
  tipe        String    @db.VarChar(50)
  judul       String    @db.VarChar(200)
  pesan       String?   @db.Text
  is_read     Boolean   @default(false)
  read_at     DateTime? @db.Timestamp(6)
  ref_id      String?   @db.Uuid
  ref_tipe    String?   @db.VarChar(50)
  created_at  DateTime  @default(now()) @db.Timestamp(6)

  penerima     User @relation("NotifikasiDiterima", fields: [penerima_id], references: [id], onDelete: Cascade)
  pengirim User @relation("NotifikasiDikirim", fields: [pengirim_id], references: [id])

  @@map("notifikasi")
}
